{
  "name": "mama-mo-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./services/*",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "db:migrate": "turbo run db:migrate --filter=./services/*",
    "seed": "tsx scripts/seed.ts",
    "contracts:sync": "bash scripts/sync-contracts.sh",
    "dev:all": "tsx scripts/dev-all.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8",
    "@mamamo/contracts": "workspace:*",
    "@mamamo/service-kit": "workspace:*",
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.4"
  }
}