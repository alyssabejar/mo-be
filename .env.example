# Shared by every service
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mamamo_<service>
NATS_URL=nats://localhost:4222
# memory = in-process bus (single process only: pnpm dev:all); nats = JetStream
EVENT_BUS=nats
JWKS_URL=http://localhost:4001/auth/jwks
JWT_ISSUER=mamamo-identity
JWT_AUDIENCE=mamamo
PORT=4000
LOG_LEVEL=info
# Comma-separated origins for CORS when a service is called without the gateway
CORS_ORIGINS=http://localhost:5173

# identity
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:4001

# reminder
SWEEP_INTERVAL_MS=300000
COURIER_WEBHOOK_SECRET=

# notification (Web Push; generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mamamo.app
DELIVERY_INTERVAL_MS=15000

# dev:all and e2e tests
DATABASE_URL_BASE=postgres://postgres@localhost:5432
TEST_DATABASE_URL_BASE=postgres://postgres@localhost:5432
